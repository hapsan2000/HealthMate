<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/card_bg"
    android:elevation="4dp">

    <!-- Doctor Image -->
    <ImageView
        android:id="@+id/doctor_image"
        android:layout_width="101dp"
        android:layout_height="117dp"
        android:scaleType="centerCrop"
        android:src="@drawable/doctor_image" />

    <!-- Text Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/doctor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Denies Martine"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/doctor_qualification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MBBS, MD"
            android:textSize="14sp"
            android:textColor="@color/gray"/>

        <TextView
            android:id="@+id/doctor_speciality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cardiologist"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primaryclr"/>

        <TextView
            android:id="@+id/doctor_experience"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="42 Years Experience"
            android:textSize="13sp"
            android:textColor="@color/gray"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"/>

            <TextView
                android:id="@+id/doctor_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apollo Hospital, West Ham"
                android:textSize="13sp"
                android:textColor="@color/gray"
                android:paddingStart="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/doctor_fee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consulting Fee ₹ 500"
            android:textSize="14sp"
            android:textColor="@color/primaryclr"
            android:textStyle="bold"
            android:paddingTop="4dp"/>

        <!-- Appoint Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appoint_now_button"
            android:layout_width="245dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Appoint Now"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/primaryclr"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Rating Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/rating_star"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_star"/>

        <TextView
            android:id="@+id/rating_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.5"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:gravity="center"/>
    </LinearLayout>

</LinearLayout>
